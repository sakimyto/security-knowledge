{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "environment": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "complete": {
      "type": "boolean"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "surfaces": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "dependencies",
                "web-app",
                "identity",
                "endpoint",
                "ci",
                "repositories",
                "containers",
                "cloud",
                "data-store",
                "support",
                "ai-agent"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "surfaces"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "environment",
    "revision",
    "complete",
    "assets"
  ],
  "additionalProperties": false
}
