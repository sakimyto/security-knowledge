{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Security Knowledge distribution discovery",
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": "1.0.0"
    },
    "schemaVersion": {
      "enum": ["1.0.0", "1.1.0"]
    },
    "catalogVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "catalogHash": {
      "$ref": "#/$defs/hash"
    },
    "repository": {
      "type": "string",
      "pattern": "^https://github\\.com/[^/]+/[^/]+$"
    },
    "locales": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["ja", "en"]
      },
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "$ref": "#/$defs/path"
          },
          "kind": {
            "type": "string",
            "enum": [
              "catalog",
              "index",
              "schema",
              "example",
              "jsonl",
              "rule",
              "incident",
              "pack",
              "quickstart",
              "full-text",
              "entry",
              "intake"
            ]
          },
          "format": {
            "type": "string",
            "enum": ["json", "jsonl", "markdown", "text"]
          },
          "locale": {
            "type": "string",
            "enum": ["ja", "en"]
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "$ref": "#/$defs/hash"
          }
        },
        "required": ["path", "kind", "format", "bytes", "sha256"],
        "additionalProperties": false
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["rule", "incident"]
          },
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-]+$"
          },
          "hash": {
            "$ref": "#/$defs/hash"
          },
          "json": {
            "$ref": "#/$defs/path"
          },
          "markdown": {
            "$ref": "#/$defs/markdown"
          },
          "surfaces": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": ["kind", "id", "hash", "json", "markdown"],
        "additionalProperties": false
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "ruleIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^SEC-\\d{3}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "markdown": {
            "$ref": "#/$defs/markdown"
          }
        },
        "required": ["id", "ruleIds", "markdown"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "formatVersion",
    "schemaVersion",
    "catalogVersion",
    "updatedAt",
    "catalogHash",
    "repository",
    "locales",
    "resources",
    "records",
    "surfaces"
  ],
  "additionalProperties": false,
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "path": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
    },
    "markdown": {
      "type": "object",
      "properties": {
        "ja": {
          "$ref": "#/$defs/path"
        },
        "en": {
          "$ref": "#/$defs/path"
        }
      },
      "required": ["ja", "en"],
      "additionalProperties": false
    }
  }
}
